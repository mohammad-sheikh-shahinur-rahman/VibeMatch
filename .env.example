# ==============================================================================
# VibeMatch - Complete Backend Environment Variables Reference
# ==============================================================================
# This file documents every accepted environment variable for the VibeMatch
# Node.js / Express / Socket.IO backend service.
#
# Usage:
# Copy this file to '.env' in your backend directory and replace the placeholders:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------

# PORT
# Description: The TCP network port that the HTTP and Socket.IO server binds to.
# Required: Optional (Defaults to 3000 if omitted)
# Valid Values: Any unprivileged port number between 1024 and 65535 (e.g., 3000, 5000, 8080)
# Example:
PORT=3000

# NODE_ENV
# Description: Specifies the runtime environment mode for Node.js and Express.
#              In 'production', Vite dev HMR is disabled and production static assets are served.
# Required: Recommended
# Valid Values: 'production' | 'development'
# Example:
NODE_ENV=production

# DEMO_MODE
# Description: Protects administrative accounts from tampering by disabling destructive
#              actions (e.g., changing demo admin passwords, dropping collections).
# Required: Optional (Defaults to 'false')
# Valid Values: 'true' | 'false'
# Example:
DEMO_MODE=false


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------

# MONGODB_URI
# Description: The full connection string URI for MongoDB (Local Community or MongoDB Atlas).
#              Used by Mongoose to establish persistent connections for user profiles,
#              transactions, chat histories, diamond balances, and system settings.
# Required: STRICTLY REQUIRED
# Valid Values: Standard MongoDB connection string starting with 'mongodb://' or 'mongodb+srv://'
# Examples:
#   Local Database:  mongodb://127.0.0.1:27017/vibematch
#   Auth Database:   mongodb://myUser:SecretPass123@127.0.0.1:27017/vibematch?authSource=admin
#   MongoDB Atlas:   mongodb+srv://admin_vibe:P%40ssw0rd@cluster0.abcde.mongodb.net/vibematch?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/vibematch"


# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JSON WEB TOKENS)
# ------------------------------------------------------------------------------

# JWT_SECRET
# Description: Cryptographic secret key used to sign and verify HMAC-SHA256 JSON Web Tokens
#              issued to authenticated mobile app users and administrative dashboard sessions.
# Required: STRICTLY REQUIRED
# Valid Values: Any high-entropy random string (minimum 32 characters recommended for production).
# Generation Tip: Run 'openssl rand -base64 32' in your terminal to generate a secure key.
# Example:
JWT_SECRET="vibe_sec_98f4e2b17a6c5d3e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9"


# ------------------------------------------------------------------------------
# 4. IN-APP PURCHASES & NATIVE STORE RECEIPT VERIFICATION
# ------------------------------------------------------------------------------

# GOOGLE_SERVICE_ACCOUNT_JSON
# Description: Minified JSON credentials of a Google Cloud Service Account that has the
#              'androidpublisher' API permission enabled in the Google Play Console.
#              Used by 'verifyGoogleReceipt' in backend/routes/payments.ts to cryptographically
#              validate Google Play Billing purchase tokens (fail-closed security).
# Required: Required only if offering Google Play In-App Purchases on Android.
# Valid Values: A single-line, minified JSON object string from Google Cloud Console.
# Example:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"vibematch-prod","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"play-billing@vibematch-prod.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
GOOGLE_SERVICE_ACCOUNT_JSON=""

# APPLE_SHARED_SECRET
# Description: The In-App Purchase Shared Secret generated inside Apple App Store Connect
#              (under Apps > Your App > App Information > App-Specific Shared Secret).
#              Used to verify auto-renewable VIP subscriptions and diamond consumable receipts.
# Required: Required only if offering Apple App Store In-App Purchases on iOS.
# Valid Values: 32-character hexadecimal string from App Store Connect.
# Example:
# APPLE_SHARED_SECRET="3b1a8f9c2d4e6a7b8c9d0e1f2a3b4c5d"
APPLE_SHARED_SECRET=""


# ------------------------------------------------------------------------------
# 5. OPTIONAL DEVELOPMENT OVERRIDES
# ------------------------------------------------------------------------------

# DISABLE_HMR
# Description: Disables Vite Hot Module Replacement in development mode if running behind
#              certain reverse proxies or constrained CPU environments.
# Required: Optional
# Valid Values: 'true' | 'false'
# Example:
DISABLE_HMR=false
